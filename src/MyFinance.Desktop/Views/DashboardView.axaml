<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyFinance.Desktop.ViewModels"
             xmlns:controls="using:MyFinance.Desktop.Controls"
             xmlns:conv="using:MyFinance.Desktop.Converters"
             x:Class="MyFinance.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer>
        <StackPanel Margin="28" Spacing="16">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Atualizar" Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Classes="page-title" Text="{Binding Title}" Margin="0" />
                    <TextBlock Classes="subtle" Text="{Binding MonthLabel}" />
                </StackPanel>
            </DockPanel>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />

            <!-- Indicadores -->
            <UniformGrid Columns="5">
                <Border Classes="card" Margin="0,0,8,0">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="subtle" Text="Saldo total" />
                        <TextBlock Classes="kpi-value" Text="{Binding TotalBalance, StringFormat={}{0:C}}" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="4,0">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="subtle" Text="Receitas do mês" />
                        <TextBlock Classes="kpi-value positive" Text="{Binding MonthIncome, StringFormat={}{0:C}}" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="4,0">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="subtle" Text="Despesas do mês" />
                        <TextBlock Classes="kpi-value negative" Text="{Binding MonthExpenses, StringFormat={}{0:C}}" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="4,0">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="subtle" Text="Saldo do mês" />
                        <TextBlock Classes="kpi-value" Text="{Binding MonthBalance, StringFormat={}{0:C}}" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="8,0,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="subtle" Text="Fatura atual" />
                        <TextBlock Classes="kpi-value" Text="{Binding CurrentInvoiceTotal, StringFormat={}{0:C}}" />
                        <ItemsControl ItemsSource="{Binding Invoices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:InvoiceItem">
                                    <TextBlock Classes="subtle" TextWrapping="Wrap">
                                        <Run Text="{Binding CardName, Mode=OneWay}" />
                                        <Run Text="·" />
                                        <Run Text="{Binding Amount, Mode=OneWay, StringFormat={}{0:C}}" />
                                        <Run Text="· vence" />
                                        <Run Text="{Binding DueDate, Mode=OneWay, StringFormat={}{0:dd/MM}}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid ColumnDefinitions="*,16,*">
                <!-- Receitas x despesas -->
                <Border Classes="card">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource MfPositiveBrush}" />
                                    <TextBlock Classes="subtle" Text="Receitas" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource MfNegativeBrush}" />
                                    <TextBlock Classes="subtle" Text="Despesas" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Classes="section-title" Text="Receitas x despesas" />
                        </DockPanel>
                        <controls:BarChart Height="220" Items="{Binding IncomeVsExpenses}"
                                           FirstBrush="{DynamicResource MfPositiveBrush}"
                                           SecondBrush="{DynamicResource MfNegativeBrush}"
                                           LabelBrush="{DynamicResource MfSubtleTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- Evolução do saldo -->
                <Border Grid.Column="2" Classes="card">
                    <StackPanel>
                        <TextBlock Classes="section-title" Text="Evolução do saldo" />
                        <controls:LineChart Height="220" Points="{Binding BalanceEvolution}"
                                            LineBrush="{DynamicResource MfChartLineBrush}"
                                            LabelBrush="{DynamicResource MfSubtleTextBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Despesas por categoria -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="Despesas do mês por categoria" />
                    <TextBlock Classes="subtle" Text="Nenhuma despesa neste mês." IsVisible="{Binding !HasExpenses}" />
                    <ItemsControl ItemsSource="{Binding ExpenseCategories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryBarItem">
                                <Grid ColumnDefinitions="180,*,120" Margin="0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="10" Height="10" CornerRadius="5"
                                                Background="{Binding Color, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ProgressBar Grid.Column="1" Value="{Binding Percent}" Maximum="100" MinHeight="10" VerticalAlignment="Center"
                                                 Foreground="{Binding Color, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat={}{0:C}}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
