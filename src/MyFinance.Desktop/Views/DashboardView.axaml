<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyFinance.Desktop.ViewModels"
             xmlns:controls="using:MyFinance.Desktop.Controls"
             xmlns:conv="using:MyFinance.Desktop.Converters"
             x:Class="MyFinance.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer>
        <StackPanel Margin="28" Spacing="16">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Atualizar" Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Classes="page-title" Text="{Binding Title}" Margin="0" />
                    <TextBlock Classes="subtle" Text="{Binding MonthLabel}" />
                </StackPanel>
            </DockPanel>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />

            <!-- Indicadores -->
            <UniformGrid Columns="2">
                <Border Classes="card" Margin="0,0,8,0">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="subtle" Text="Gastos do mês" />
                        <TextBlock Classes="kpi-value" Text="{Binding MonthSpending, StringFormat={}{0:C}}" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="8,0,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="subtle" Text="Faturas abertas" />
                        <TextBlock Classes="kpi-value" Text="{Binding CurrentInvoiceTotal, StringFormat={}{0:C}}" />
                        <ItemsControl ItemsSource="{Binding Invoices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:InvoiceItem">
                                    <TextBlock Classes="subtle" TextWrapping="Wrap">
                                        <Run Text="{Binding CardName, Mode=OneWay}" />
                                        <Run Text="·" />
                                        <Run Text="{Binding Amount, Mode=OneWay, StringFormat={}{0:C}}" />
                                        <Run Text="· vence" />
                                        <Run Text="{Binding DueDate, Mode=OneWay, StringFormat={}{0:dd/MM}}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Evolução -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="Gastos por mês" />
                    <controls:LineChart Height="220" Points="{Binding MonthlySpending}"
                                        LineBrush="{DynamicResource MfChartLineBrush}"
                                        LabelBrush="{DynamicResource MfSubtleTextBrush}" />
                </StackPanel>
            </Border>

            <!-- Gastos por categoria -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="Gastos do mês por categoria" />
                    <TextBlock Classes="subtle" Text="Nenhum gasto neste mês." IsVisible="{Binding !HasSpending}" />
                    <ItemsControl ItemsSource="{Binding SpendingCategories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryBarItem">
                                <Grid ColumnDefinitions="180,*,120" Margin="0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="10" Height="10" CornerRadius="5"
                                                Background="{Binding Color, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ProgressBar Grid.Column="1" Value="{Binding Percent}" Maximum="100" MinHeight="10" VerticalAlignment="Center"
                                                 Foreground="{Binding Color, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat={}{0:C}}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>