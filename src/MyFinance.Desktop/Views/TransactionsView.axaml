<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyFinance.Desktop.ViewModels"
             x:Class="MyFinance.Desktop.Views.TransactionsView"
             x:DataType="vm:TransactionsViewModel">

    <DockPanel Margin="28">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Classes="page-title" Text="{Binding Title}" />

            <!-- Filtros -->
            <Border Classes="card" Margin="0,0,0,12">
                <WrapPanel>
                    <ComboBox ItemsSource="{Binding OwnerOptions}" SelectedItem="{Binding SelectedOwner, Mode=TwoWay}" Width="230" Margin="0,0,8,8" />
                    <ComboBox ItemsSource="{Binding CategoryFilterOptions}" SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}" Width="200" Margin="0,0,8,8" />
                    <CalendarDatePicker SelectedDate="{Binding FromDate}" PlaceholderText="De" Width="140" Margin="0,0,8,8" />
                    <CalendarDatePicker SelectedDate="{Binding ToDate}" PlaceholderText="Até" Width="140" Margin="0,0,8,8" />
                    <TextBox Text="{Binding SearchText}" PlaceholderText="Buscar na descrição" Width="220" Margin="0,0,8,8" />
                    <Button Classes="accent" Content="Filtrar" Command="{Binding SearchCommand}" IsDefault="True" Margin="0,0,8,8" />
                    <Button Content="Limpar" Command="{Binding ClearFiltersCommand}" Margin="0,0,8,8" />
                </WrapPanel>
            </Border>

            <Border Classes="status-success" IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Margin="0,0,0,8" />
        </StackPanel>

        <!-- Paginação -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="Anterior" Command="{Binding PreviousPageCommand}" />
                <Button Content="Próxima" Command="{Binding NextPageCommand}" />
            </StackPanel>
            <TextBlock Classes="subtle" VerticalAlignment="Center" Text="{Binding PageLabel}" />
        </DockPanel>

        <!-- Lista: Data | Descrição | Conta/Cartão | Categoria | Valor -->
        <Border Classes="card" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="100,*,200,260,130" Margin="16,10">
                    <TextBlock Classes="subtle" Text="Data" />
                    <TextBlock Grid.Column="1" Classes="subtle" Text="Descrição" />
                    <TextBlock Grid.Column="2" Classes="subtle" Text="Conta / cartão" />
                    <TextBlock Grid.Column="3" Classes="subtle" Text="Categoria" />
                    <TextBlock Grid.Column="4" Classes="subtle" Text="Valor" HorizontalAlignment="Right" />
                </Grid>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TransactionRowViewModel">
                                <Border BorderBrush="{DynamicResource MfCardBorderBrush}" BorderThickness="0,1,0,0" Padding="16,6">
                                    <Grid ColumnDefinitions="100,*,200,260,130">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Item.Date, StringFormat={}{0:dd/MM/yyyy}}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Item.Description}"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Item.Description}" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="2" Classes="subtle" VerticalAlignment="Center" Text="{Binding OwnerLabel}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <ComboBox Grid.Column="3" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" Margin="0,0,8,0" PlaceholderText="(sem categoria)" />
                                        <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"
                                                   Text="{Binding Item.Amount, StringFormat={}{0:C}}"
                                                   Classes.negative="{Binding IsExpense}" Classes.positive="{Binding !IsExpense}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
