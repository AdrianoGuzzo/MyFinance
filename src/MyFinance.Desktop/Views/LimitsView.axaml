<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyFinance.Desktop.ViewModels"
             xmlns:conv="using:MyFinance.Desktop.Converters"
             x:Class="MyFinance.Desktop.Views.LimitsView"
             x:DataType="vm:LimitsViewModel">

    <DockPanel Margin="28">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Classes="page-title" Text="{Binding Title}" Margin="0" />
            <TextBlock Classes="subtle" Text="{Binding MonthLabel}" Margin="0,0,0,16" />
            <Border Classes="status-success" IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Margin="0,0,0,8" />
        </StackPanel>

        <Grid ColumnDefinitions="*,20,340">
            <Border Classes="card" Padding="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="subtle" Margin="16,12" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}"
                               Text="Nenhum limite definido. Um limite por categoria; a categoria principal inclui as subcategorias." />
                    <ListBox ItemsSource="{Binding Limits}" SelectedItem="{Binding Selected, Mode=TwoWay}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LimitRowViewModel">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,4"
                                      Opacity="{Binding Limit.IsActive, Converter={x:Static conv:BoolToOpacityConverter.Instance}}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                                Background="{Binding Limit.Color, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                                        <TextBlock Text="{Binding Limit.CategoryName}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right">
                                        <Run Text="{Binding Limit.Used, Mode=OneWay, StringFormat={}{0:C}}" FontWeight="SemiBold" />
                                        <Run Text="de" />
                                        <Run Text="{Binding Limit.MonthlyAmount, Mode=OneWay, StringFormat={}{0:C}}" />
                                    </TextBlock>
                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Classes="meter" Classes.near="{Binding IsNear}"
                                                 Classes.exceeded="{Binding IsExceeded}" Value="{Binding BarPercent}" Maximum="100"
                                                 MinHeight="10" Margin="0,6" />
                                    <TextBlock Grid.Row="2" Classes="subtle" Text="{Binding StatusText}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="subtle" HorizontalAlignment="Right">
                                        <Run Text="{Binding PercentText, Mode=OneWay}" />
                                        <Run Text="·" />
                                        <Run Text="{Binding BalanceText, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Classes="card" VerticalAlignment="Top">
                <StackPanel Classes="form">
                    <TextBlock Classes="section-title" Text="{Binding FormTitle}" TextWrapping="Wrap" />
                    <TextBlock Classes="field-label" Text="Categoria *" />
                    <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding Category, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" IsEnabled="{Binding !IsEditing}" />
                    <TextBlock Classes="field-label" Text="Limite mensal *" />
                    <NumericUpDown Value="{Binding Amount}" FormatString="N2" Increment="50" Minimum="0" />
                    <TextBlock Classes="subtle" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="A partir de 80% do limite a situação passa a &quot;próximo do limite&quot;." />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,20,0,0">
                        <Button Classes="accent" Content="Salvar" Command="{Binding SaveCommand}" />
                        <Button Content="Novo" Command="{Binding NewCommand}" IsVisible="{Binding IsEditing}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" IsVisible="{Binding IsEditing}">
                        <Button Content="Desativar" Command="{Binding DeactivateCommand}" />
                        <Button Content="Reativar" Command="{Binding ActivateCommand}" />
                        <Button Classes="destructive" Content="Excluir" Command="{Binding DeleteCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>