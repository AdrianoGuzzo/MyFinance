<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyFinance.Desktop.ViewModels"
             xmlns:app="using:MyFinance.Application.Categories"
             xmlns:conv="using:MyFinance.Desktop.Converters"
             x:Class="MyFinance.Desktop.Views.CategoriesView"
             x:DataType="vm:CategoriesViewModel">

    <DockPanel Margin="28">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Classes="page-title" Text="{Binding Title}" />
            <Border Classes="status-success" IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Margin="0,0,0,8" />
        </StackPanel>

        <Grid ColumnDefinitions="*,20,340">
            <Border Classes="card" Padding="0">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Top" Margin="16,12" Content="Mostrar desativadas" IsChecked="{Binding ShowInactive}" />
                    <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Selected, Mode=TwoWay}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="app:CategoryDto">
                                <Grid ColumnDefinitions="Auto,*,Auto" Opacity="{Binding IsActive, Converter={x:Static conv:BoolToOpacityConverter.Instance}}"
                                      Margin="{Binding ParentCategoryId, Converter={x:Static conv:SubcategoryIndentConverter.Instance}}">
                                    <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center"
                                            Background="{Binding Color, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Classes="subtle" VerticalAlignment="Center"
                                               Text="{Binding Type, Converter={x:Static conv:EnumLabelConverter.Instance}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Classes="card" VerticalAlignment="Top">
                <StackPanel Classes="form">
                    <TextBlock Classes="section-title" Text="{Binding FormTitle}" TextWrapping="Wrap" />
                    <TextBlock Classes="field-label" Text="Nome *" />
                    <TextBox Text="{Binding Name}" PlaceholderText="Ex.: Pets" />
                    <TextBlock Classes="field-label" Text="Categoria principal" />
                    <ComboBox ItemsSource="{Binding ParentOptions}" SelectedItem="{Binding Parent, Mode=TwoWay}" IsEnabled="{Binding !IsEditing}" />
                    <TextBlock Classes="field-label" Text="Tipo" />
                    <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type, Mode=TwoWay}" IsEnabled="{Binding CanChooseType}" />
                    <TextBlock Classes="subtle" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Transferência: pagamento de fatura e movimentações entre suas contas. Não conta como receita nem despesa." />
                    <TextBlock Classes="field-label" Text="Cor (#RRGGBB)" />
                    <Grid ColumnDefinitions="*,8,32">
                        <TextBox Text="{Binding Color}" PlaceholderText="#95A5A6" />
                        <Border Grid.Column="2" CornerRadius="6" Height="32"
                                Background="{Binding Color, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,20,0,0">
                        <Button Classes="accent" Content="Salvar" Command="{Binding SaveCommand}" />
                        <Button Content="Nova" Command="{Binding NewCommand}" IsVisible="{Binding IsEditing}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" IsVisible="{Binding IsEditing}">
                        <Button Classes="destructive" Content="Desativar" Command="{Binding DeactivateCommand}" />
                        <Button Content="Reativar" Command="{Binding ActivateCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
