<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyFinance.Desktop.ViewModels"
             xmlns:views="using:MyFinance.Desktop.Views"
             x:Class="MyFinance.Desktop.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="MfSidebarBrush" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="MfCardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MfCardBorderBrush" Color="#E5E7EB" />
                    <SolidColorBrush x:Key="MfPageBrush" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="MfSubtleTextBrush" Color="#6B7280" />
                    <SolidColorBrush x:Key="MfPositiveBrush" Color="#15803D" />
                    <SolidColorBrush x:Key="MfNegativeBrush" Color="#B91C1C" />
                    <SolidColorBrush x:Key="MfWarningBackgroundBrush" Color="#FEF3C7" />
                    <SolidColorBrush x:Key="MfSuccessBackgroundBrush" Color="#DCFCE7" />
                    <SolidColorBrush x:Key="MfErrorBackgroundBrush" Color="#FEE2E2" />
                    <SolidColorBrush x:Key="MfOverlayBrush" Color="#66000000" />
                    <SolidColorBrush x:Key="MfChartLineBrush" Color="#2563EB" />
                    <!-- Paleta dos gráficos (slots 1 e 2 validados para daltonismo e contraste nos dois temas). -->
                    <SolidColorBrush x:Key="MfSeries1Brush" Color="#2A78D6" />
                    <SolidColorBrush x:Key="MfSeries2Brush" Color="#EB6834" />
                    <!-- Medidor de limite: acento → atenção → perigo (sempre acompanhado de símbolo e texto). -->
                    <SolidColorBrush x:Key="MfWarningBrush" Color="#B45309" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="MfSidebarBrush" Color="#1F2023" />
                    <SolidColorBrush x:Key="MfCardBrush" Color="#26272B" />
                    <SolidColorBrush x:Key="MfCardBorderBrush" Color="#34363B" />
                    <SolidColorBrush x:Key="MfPageBrush" Color="#18181B" />
                    <SolidColorBrush x:Key="MfSubtleTextBrush" Color="#9CA3AF" />
                    <SolidColorBrush x:Key="MfPositiveBrush" Color="#4ADE80" />
                    <SolidColorBrush x:Key="MfNegativeBrush" Color="#F87171" />
                    <SolidColorBrush x:Key="MfWarningBackgroundBrush" Color="#422006" />
                    <SolidColorBrush x:Key="MfSuccessBackgroundBrush" Color="#052E16" />
                    <SolidColorBrush x:Key="MfErrorBackgroundBrush" Color="#450A0A" />
                    <SolidColorBrush x:Key="MfOverlayBrush" Color="#99000000" />
                    <SolidColorBrush x:Key="MfChartLineBrush" Color="#60A5FA" />
                    <SolidColorBrush x:Key="MfSeries1Brush" Color="#3987E5" />
                    <SolidColorBrush x:Key="MfSeries2Brush" Color="#D95926" />
                    <SolidColorBrush x:Key="MfWarningBrush" Color="#F59E0B" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <!-- Views resolvidas por tipo de ViewModel, sem reflexão. -->
    <Application.DataTemplates>
        <DataTemplate DataType="vm:DashboardViewModel"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="vm:CreditCardsViewModel"><views:CreditCardsView /></DataTemplate>
        <DataTemplate DataType="vm:TransactionsViewModel"><views:TransactionsView /></DataTemplate>
        <DataTemplate DataType="vm:CategoriesViewModel"><views:CategoriesView /></DataTemplate>
        <DataTemplate DataType="vm:CategoryRulesViewModel"><views:CategoryRulesView /></DataTemplate>
        <DataTemplate DataType="vm:InvoicesViewModel"><views:InvoicesView /></DataTemplate>
        <DataTemplate DataType="vm:InstallmentsViewModel"><views:InstallmentsView /></DataTemplate>
        <DataTemplate DataType="vm:ReportsViewModel"><views:ReportsView /></DataTemplate>
        <DataTemplate DataType="vm:LimitsViewModel"><views:LimitsView /></DataTemplate>
        <DataTemplate DataType="vm:RecurringViewModel"><views:RecurringView /></DataTemplate>
        <DataTemplate DataType="vm:StrategyViewModel"><views:StrategyView /></DataTemplate>
        <DataTemplate DataType="vm:ImportViewModel"><views:ImportView /></DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://MyFinance.Desktop/Styles/AppStyles.axaml" />
    </Application.Styles>
</Application>
